{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "0.4.5",
  "description": "Save job applications to your own Notion database in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track this job application"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.notion.com/*", "https://www.linkedin.com/*"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
